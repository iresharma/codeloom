#!/usr/bin/env bash
# Auto-init inner git repos under workspace/.
# If an inner repo has an origin remote, the outer repo records it as a
# submodule (GitHub shows a link). Otherwise the outer repo tracks the files.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORKSPACE="$ROOT/workspace"
cd "$ROOT"

is_git_repo() {
  local dir="$1"
  [[ -d "$dir/.git" || -f "$dir/.git" ]]
}

inner_origin() {
  git -C "$1" remote get-url origin 2>/dev/null || true
}

submodule_paths() {
  git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
    | awk '{print $2}' || true
}

is_submodule_path() {
  local rel="${1%/}"
  local sm
  while IFS= read -r sm; do
    [[ -n "$sm" ]] || continue
    if [[ "$rel" == "$sm" || "$rel" == "$sm"/* ]]; then
      return 0
    fi
  done < <(submodule_paths)
  return 1
}

ensure_inner_commit() {
  local dir="$1"
  if git -C "$dir" rev-parse --verify HEAD >/dev/null 2>&1; then
    return 0
  fi
  git -C "$dir" \
    -c user.name="${GIT_AUTHOR_NAME:-codeloom}" \
    -c user.email="${GIT_AUTHOR_EMAIL:-codeloom@local}" \
    commit --allow-empty -q -m "Initial commit"
}

init_inner_repos() {
  [[ -d "$WORKSPACE" ]] || return 0

  local dir
  for dir in "$WORKSPACE"/*/; do
    [[ -d "$dir" ]] || continue
    if ! is_git_repo "$dir"; then
      git -C "$dir" init -b main -q
      echo "initialized inner repo: ${dir#"$ROOT"/}"
    fi
    ensure_inner_commit "$dir"
  done
}

register_submodules() {
  [[ -d workspace ]] || return 0
  git rev-parse --git-dir >/dev/null 2>&1 || return 0

  local dir rel url sha path
  for dir in workspace/*/; do
    [[ -d "$dir" ]] || continue
    rel="${dir%/}"
    url="$(inner_origin "$dir")"
    [[ -n "$url" ]] || continue

    sha="$(git -C "$dir" rev-parse HEAD)"

    while IFS= read -r -d '' path; do
      [[ "$path" == "$rel" ]] && continue
      git update-index --force-remove -- "$path" 2>/dev/null || true
    done < <(git ls-files -z -- "$rel")

    git update-index --add --cacheinfo "160000,$sha,$rel"
    git config -f .gitmodules "submodule.$rel.path" "$rel"
    git config -f .gitmodules "submodule.$rel.url" "$url"
  done

  if [[ -f .gitmodules ]]; then
    git add -- .gitmodules
  fi
}

unsubmodule_local_gitlinks() {
  local path
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    if is_submodule_path "$path"; then
      continue
    fi
    git rm --cached -q -f -- "$path" || true
  done < <(git ls-files -s | awk '$1 == "160000" {print $4}')
}

add_local_inner_files() {
  [[ -d workspace ]] || return 0

  local tmp rel
  tmp="$(mktemp)"
  while IFS= read -r -d '' rel; do
    if is_submodule_path "$rel"; then
      continue
    fi
    if git check-ignore -q -- "$rel" 2>/dev/null; then
      continue
    fi
    printf '%s\0' "$rel"
  done < <(
    find workspace \
      -type f \
      -not -name '.git' \
      -not -path '*/.git/*' \
      -print0
  ) >"$tmp"

  if [[ -s "$tmp" ]]; then
    git update-index --add -z --stdin <"$tmp"
  fi
  rm -f "$tmp"
}

prune_deleted_local_files() {
  local path
  while IFS= read -r -d '' path; do
    [[ "$path" == workspace/* ]] || continue
    if is_submodule_path "$path"; then
      continue
    fi
    if [[ ! -e "$path" ]]; then
      git update-index --remove -- "$path" || true
    fi
  done < <(git ls-files -z -- workspace)
}

init_inner_repos

if git rev-parse --git-dir >/dev/null 2>&1; then
  register_submodules
  unsubmodule_local_gitlinks
  add_local_inner_files
  prune_deleted_local_files
fi
