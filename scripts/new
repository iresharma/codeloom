#!/usr/bin/env bash
# Create a workspace folder and initialize an inner git repo.
# Usage: ./scripts/new <folder-name> [origin-url]
# If origin-url is set, the next outer commit records a submodule link.
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: $0 <folder-name> [origin-url]" >&2
  exit 1
fi

name="$1"
if [[ "$name" == *"/"* || "$name" == "." || "$name" == ".." ]]; then
  echo "error: folder name must be a single path segment" >&2
  exit 1
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
dir="$ROOT/workspace/$name"

if [[ -e "$dir" ]]; then
  echo "error: $dir already exists" >&2
  exit 1
fi

mkdir -p "$dir"
git -C "$dir" init -b main -q
git -C "$dir" \
  -c user.name="${GIT_AUTHOR_NAME:-codeloom}" \
  -c user.email="${GIT_AUTHOR_EMAIL:-codeloom@local}" \
  commit --allow-empty -q -m "Initial commit"

if [[ $# -eq 2 ]]; then
  git -C "$dir" remote add origin "$2"
  echo "created workspace/$name with origin $2"
  echo "outer git commit will store a submodule link to that repo"
else
  echo "created workspace/$name (inner git repo ready)"
fi
echo "cd workspace/$name"
